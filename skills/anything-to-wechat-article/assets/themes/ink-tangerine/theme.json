{
  "id": "ink-tangerine",
  "name_zh": "墨蓝橘笺",
  "style_desc": "深藏蓝压阵、橘色点睛的经典杂志笺：留白克制，信息卡与引用块用暖白纸面。",
  "recipe": "沉稳、杂志感、正式汇报",
  "tokens": {
    "primary": "#20344F",
    "accent": "#E27145",
    "ink": "#20344F",
    "body": "#3F3F3F",
    "muted": "#8A94A0",
    "muted_dark": "#5A6675",
    "surface": "#FAF8F4",
    "surface_alt": "#F2F2F2",
    "border": "#C9CDD3",
    "border_accent": "#E27145",
    "page_bg": "#FFFFFF",
    "radius": "6px",
    "radius_sm": "4px",
    "font_stack": "-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif",
    "title_font": "-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif"
  },
  "page": {
    "max_width": "677px",
    "padding": "24px 20px 56px",
    "font_size": "16px",
    "line_height": "1.85",
    "letter_spacing": ".3px"
  },
  "styles": {
    "kicker": "margin:0 0 6px;text-align:center;font-size:13px;letter-spacing:2px;color:{accent};",
    "title": "margin:0 0 10px;text-align:center;font-size:25px;line-height:1.5;color:{primary};font-weight:800;letter-spacing:.5px;",
    "subtitle": "margin:0 0 24px;text-align:center;font-size:14px;color:{muted};",
    "meta": "margin:0 0 30px;padding:16px 18px;background:{surface};border-radius:{radius};font-size:14px;line-height:1.9;color:{muted_dark};",
    "meta_label": "color:{primary};",
    "lead": "margin:0 0 18px;text-align:justify;",
    "divider": "margin:0 0 34px;text-align:center;color:{border};font-size:14px;letter-spacing:6px;",
    "paragraph": "margin:0 0 18px;text-align:justify;",
    "h3": "margin:26px 0 12px;font-size:17px;color:{primary};font-weight:700;",
    "list_item": "margin:0 0 12px;padding-left:30px;text-indent:-30px;font-size:15px;line-height:1.8;",
    "highlight": "color:{primary};font-weight:700;",
    "quote": "margin:24px 0 28px;padding:16px 18px;background:{surface};border-left:4px solid {accent};color:{primary};font-size:17px;line-height:1.85;",
    "card": "margin:0 0 16px;padding:14px 18px;background:{surface};border-radius:{radius};font-size:15px;line-height:1.8;",
    "aside": "margin:4px 0 26px;padding:20px 18px 14px;background:{surface};border:1px solid {border};border-radius:{radius};",
    "aside_title": "margin:0 0 6px;font-size:15px;font-weight:700;color:{primary};letter-spacing:.5px;",
    "tip": "margin:0 0 20px;padding:14px 18px;background:{surface};border-left:4px solid {primary};border-radius:{radius};font-size:14px;line-height:1.8;color:{muted_dark};",
    "th": "background:{primary};color:#FFFFFF;font-weight:700;padding:8px 12px;text-align:left;",
    "td": "padding:8px 12px;border-bottom:1px solid {border};color:{body};",
    "td_alt": "padding:8px 12px;border-bottom:1px solid {border};color:{body};background:{surface};",
    "caption": "margin:0 0 26px;text-align:center;font-size:13px;color:{muted};",
    "source": "padding:16px 18px;background:{surface};border-radius:{radius};font-size:13px;line-height:1.9;color:{muted};",
    "source_heading": "color:{muted_dark};",
    "source_item": "color:{muted};"
  },
  "code": {
    "bg": "#F4F2ED",
    "text": "#1F2933",
    "keyword": "#A85632",
    "comment": "#5F6B78",
    "border": "#D6D0C5",
    "accent": "#20344F",
    "frame_style": "margin:0 0 24px;border-radius:{radius};overflow:hidden;background:{code_bg};border:1px solid {code_border};border-left:4px solid {code_accent};",
    "header_style": "padding:8px 14px;background:{code_bg};border-bottom:1px solid {code_border};",
    "label_style": "font-size:12px;color:{code_label};font-family:Consolas,Monaco,monospace;letter-spacing:1px;",
    "body_style": "padding:12px 14px;",
    "line_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.6;color:{code_text};",
    "comment_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.6;color:{code_comment};",
    "keyword_style": "color:{code_keyword};font-weight:700;",
    "label": "#A85632"
  },
  "html": {
    "head": "<p style=\"margin:38px 0 16px;\"><span style=\"display:inline-block;padding:3px 10px;background:{primary};color:#FFFFFF;font-size:13px;border-radius:3px;letter-spacing:1px;\">{{no}}</span>　<strong style=\"font-size:20px;color:{primary};\">{{heading}}</strong></p>",
    "takeaways_head": "<p style=\"margin:38px 0 16px;\"><span style=\"display:inline-block;padding:3px 10px;background:{accent};color:#FFFFFF;font-size:13px;border-radius:3px;letter-spacing:1px;\">带走</span>　<strong style=\"font-size:20px;color:{primary};\">{{heading}}</strong></p>",
    "takeaway_item": "<div style=\"margin:0 0 16px;padding:14px 18px;background:{surface};border-radius:{radius};font-size:15px;line-height:1.8;\"><strong style=\"color:{accent};\">{{n}}</strong>　{{text}}</div>",
    "closing": "<blockquote style=\"margin:24px 0 30px;padding:18px;background:{primary};color:#FFFFFF;font-size:17px;line-height:1.9;border-radius:{radius};\">{{text}}</blockquote>",
    "source": "<div style=\"{{source_style}}\"><strong style=\"{{source_heading_style}}\">{{heading}}</strong><br>{{items}}</div>",
    "figure": "<div style=\"margin:26px 0 8px;padding:0;\">{{img}}</div>",
    "figure_caption": "<p style=\"{{caption_style}}\">{{caption}}</p>",
    "table": "<div style=\"margin:0 0 24px;overflow-x:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:13px;\"><tr>{{head}}</tr>{{rows}}</table></div>",
    "code": "<div style=\"{code_frame}\"><div style=\"{code_header}\">{{dots}}<span style=\"{code_label}\">{{lang}}</span></div><div style=\"{code_body}\">{{lines}}</div></div>"
  }
}
