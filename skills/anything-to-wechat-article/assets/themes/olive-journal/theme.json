{
  "id": "olive-journal",
  "name_zh": "橄榄手记",
  "style_desc": "米白纸面手账：橄榄灰纸色、墨色标题条、橙色圆点与细线标记，像一页被认真标注过的笔记。",
  "recipe": "手账、暖调、编辑感",
  "tokens": {
    "primary": "#1E1F23",
    "accent": "#ED7B2F",
    "ink": "#23251D",
    "body": "#4D4F46",
    "muted": "#9EA096",
    "muted_dark": "#65675E",
    "surface": "#EEEFE9",
    "surface_alt": "#FDFDF8",
    "border": "#BFC1B7",
    "border_accent": "#ED7B2F",
    "page_bg": "#FDFDF8",
    "radius": "6px",
    "radius_sm": "4px",
    "font_stack": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif",
    "title_font": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif"
  },
  "page": {
    "max_width": "677px",
    "padding": "28px 20px 56px",
    "font_size": "16px",
    "line_height": "1.85",
    "letter_spacing": "0.5px"
  },
  "styles": {
    "kicker": "margin:0 0 8px;font-size:11px;font-weight:700;letter-spacing:2px;color:{accent};",
    "title": "margin:0 0 12px;font-size:26px;font-weight:800;color:{ink};line-height:1.4;letter-spacing:0.5px;",
    "subtitle": "margin:0 0 20px;font-size:13px;color:{muted_dark};line-height:1.8;",
    "meta": "margin:0 0 28px;padding:12px 16px;background:{surface};border:1px solid {border};border-radius:{radius};font-size:13px;line-height:1.9;color:{body};",
    "meta_label": "color:{ink};font-weight:700;",
    "lead": "margin:0 0 16px;font-size:14px;line-height:1.9;text-align:justify;color:{body};",
    "divider": "margin:6px 0 26px;border-top:1px solid {border};height:0;line-height:0;",
    "paragraph": "margin:0 0 16px;font-size:14px;line-height:1.9;text-align:justify;color:{body};",
    "h3": "margin:24px 0 10px;font-size:16px;font-weight:800;color:{ink};",
    "list_item": "margin:0 0 12px;padding-left:30px;text-indent:-30px;font-size:14px;line-height:1.9;color:{body};",
    "highlight": "border-bottom:2px solid {accent};font-weight:600;color:{ink};",
    "quote": "margin:24px 0 28px;padding:16px 18px;background:{surface};border-left:3px solid {accent};border-radius:0 {radius} {radius} 0;font-size:15px;line-height:1.9;color:{ink};",
    "card": "margin:0 0 10px;padding:12px 16px;background:{surface};border:1px solid {border};border-left:3px solid {accent};border-radius:{radius_sm};font-size:14px;line-height:1.8;color:{body};",
    "aside": "margin:4px 0 26px;padding:20px 18px 14px;background:{surface};border:1px solid {border};border-radius:{radius};",
    "aside_title": "margin:0 0 6px;font-size:15px;font-weight:700;color:{primary};letter-spacing:.5px;",
    "tip": "margin:0 0 20px;padding:14px 16px;background:{surface};border:1px solid {border};border-radius:{radius};font-size:14px;line-height:1.8;color:{body};",
    "th": "background:{primary};color:#FDFDF8;font-weight:700;padding:8px 12px;text-align:left;border-bottom:1px solid {primary};",
    "td": "padding:8px 12px;border-bottom:1px solid {border};color:{body};",
    "td_alt": "padding:8px 12px;border-bottom:1px solid {border};color:{body};background:{surface};",
    "caption": "margin:0 0 24px;text-align:center;font-size:12px;color:{muted_dark};letter-spacing:0.5px;",
    "source": "border:1px solid {border};margin:16px 0 0;font-size:12px;line-height:1.9;color:{muted_dark};",
    "source_heading": "color:#FDFDF8;background:{primary};font-size:12px;font-weight:700;letter-spacing:1px;",
    "source_item": "color:{muted_dark};"
  },
  "code": {
    "bg": "#FDFDF8",
    "text": "#23251D",
    "keyword": "#B05A16",
    "comment": "#65675E",
    "border": "#BFC1B7",
    "accent": "#ED7B2F",
    "frame_style": "margin:0 0 22px;border-radius:{radius};overflow:hidden;background:{code_bg};border:1px solid {code_border};border-left:3px solid {code_accent};",
    "header_style": "display:flex;align-items:center;padding:7px 12px;background:#1E1F23;",
    "label_style": "margin-left:10px;font-size:11px;color:{code_label};font-family:Consolas,Monaco,monospace;letter-spacing:1.5px;",
    "body_style": "padding:12px 14px;",
    "line_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.7;color:{code_text};",
    "comment_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.7;color:{code_comment};",
    "keyword_style": "color:{code_keyword};font-weight:700;",
    "dots": true,
    "label": "#ED7B2F"
  },
  "html": {
    "head": "<div style=\"margin:34px 0 18px;\"><div style=\"display:flex;align-items:center;gap:14px;\"><div style=\"text-align:center;flex-shrink:0;\"><p style=\"margin:0;font-size:24px;font-weight:800;color:{ink};line-height:1;letter-spacing:-2px;\">{{no}}</p><p style=\"margin:0;font-size:8px;font-weight:700;color:{muted};letter-spacing:2px;\">PART</p></div><span style=\"width:1px;height:36px;background:{border};display:block;\"></span><div><p style=\"margin:0;font-size:20px;font-weight:800;color:{ink};line-height:1.4;\">{{heading}}</p>{{sub_html}}</div></div></div>",
    "takeaways_head": "<div style=\"margin:42px 0 20px;padding-top:14px;border-top:2px solid {primary};\"><p style=\"margin:0 0 2px;font-size:24px;font-weight:800;color:{accent};line-height:1;letter-spacing:-1px;\">LAST</p><p style=\"margin:0;font-size:11px;font-weight:700;color:{muted_dark};letter-spacing:1.5px;\">{{heading}}</p></div>",
    "takeaway_item": "<div style=\"display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid {border};\"><span style=\"display:inline-block;flex-shrink:0;margin-top:1px;padding:3px 8px;background:{surface};border:1px solid {border};font-size:10px;font-weight:700;color:{accent};letter-spacing:1px;\">STEP {{n}}</span><p style=\"margin:0;font-size:14px;color:{body};line-height:1.8;flex:1;\">{{text}}</p></div>",
    "closing": "<blockquote style=\"margin:26px 0 30px;padding:4px;background:{primary};border-radius:{radius};\"><div style=\"border:1px solid #FDFDF8;padding:20px;text-align:center;color:#FDFDF8;font-size:15px;line-height:1.9;\">{{text}}</div></blockquote>",
    "source": "<div style=\"margin:28px 0 0;\"><div style=\"display:inline-block;padding:6px 12px;background:{primary};color:#FDFDF8;font-size:12px;font-weight:700;letter-spacing:1px;\">{{heading}}</div><div style=\"border:1px solid {border};border-top:0;padding:12px 14px;font-size:12px;line-height:1.9;color:{muted_dark};\">{{items}}</div></div>",
    "figure": "<div style=\"margin:8px 0 8px;border:1px solid {border};border-radius:{radius};overflow:hidden;\">{{img}}</div>",
    "figure_caption": "<p style=\"{{caption_style}}\">{{caption}}</p>",
    "table": "<div style=\"margin:0 0 24px;overflow-x:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:13px;\"><tr>{{head}}</tr>{{rows}}</table></div>",
    "code": "<div style=\"{code_frame}\"><div style=\"{code_header}\">{{dots}}<span style=\"{code_label}\">{{lang}}</span></div><div style=\"{code_body}\">{{lines}}</div></div>"
  }
}
