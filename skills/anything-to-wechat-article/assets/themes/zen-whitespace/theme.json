{
  "id": "zen-whitespace",
  "name_zh": "留白禅意风",
  "style_desc": "大留白灰绿：细发丝线、衬线标题、几乎不用的色块，靠字距与留白建立节奏。",
  "recipe": "留白、学术、克制",
  "tokens": {
    "primary": "#4A5D52",
    "accent": "#B5C8BC",
    "ink": "#2B2B2B",
    "body": "#525252",
    "muted": "#A3A3A3",
    "muted_dark": "#6C7068",
    "surface": "#F7F9F8",
    "surface_alt": "#FFFFFF",
    "border": "#E8E8E8",
    "border_accent": "#B5C8BC",
    "page_bg": "#FFFFFF",
    "radius": "0",
    "radius_sm": "0",
    "font_stack": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif",
    "title_font": "Georgia,'Songti SC','Noto Serif SC','Times New Roman',serif"
  },
  "page": {
    "max_width": "677px",
    "padding": "32px 24px 60px",
    "font_size": "16px",
    "line_height": "1.9",
    "letter_spacing": "0.5px"
  },
  "styles": {
    "kicker": "margin:0 0 18px;text-align:center;font-size:10px;font-weight:600;letter-spacing:4px;color:{primary};text-transform:uppercase;",
    "title": "margin:0 0 16px;text-align:center;font-family:{title_font};font-size:26px;font-weight:700;color:{ink};line-height:1.5;letter-spacing:0.5px;",
    "subtitle": "margin:0 0 26px;text-align:center;font-size:13px;color:{muted_dark};line-height:1.9;letter-spacing:1px;",
    "meta": "margin:0 0 32px;padding:16px 0;border-top:1px solid {border};border-bottom:1px solid {border};font-size:13px;line-height:2;color:{muted_dark};text-align:center;",
    "meta_label": "color:{primary};font-weight:600;",
    "lead": "margin:0 0 26px;font-size:15px;line-height:1.9;text-align:justify;color:{body};",
    "divider": "margin:8px 0 34px;text-align:center;color:{border_accent};font-size:12px;letter-spacing:8px;",
    "paragraph": "margin:0 0 26px;font-size:15px;line-height:1.9;text-align:justify;color:{body};",
    "h3": "margin:30px 0 12px;font-family:{title_font};font-size:17px;font-weight:700;color:{ink};letter-spacing:0.5px;",
    "list_item": "margin:0 0 12px;padding-left:30px;text-indent:-30px;font-size:14px;line-height:1.9;color:{body};",
    "highlight": "border-bottom:1.5px solid {border_accent};font-weight:500;color:{ink};",
    "quote": "margin:36px 0;padding:28px 20px;border-top:1px solid {border};border-bottom:1px solid {border};text-align:center;font-family:{title_font};font-size:17px;line-height:1.9;color:{ink};letter-spacing:0.8px;",
    "card": "margin:0;padding:16px 0;border-bottom:1px solid {border};font-size:14px;line-height:1.9;color:{body};",
    "aside": "margin:4px 0 26px;padding:20px 18px 14px;background:{surface};border:1px solid {border};border-radius:{radius};",
    "aside_title": "margin:0 0 6px;font-size:15px;font-weight:700;color:{primary};letter-spacing:.5px;",
    "tip": "margin:0 0 26px;padding:0 0 0 14px;border-left:2px solid {primary};font-size:14px;line-height:1.9;color:{muted_dark};",
    "th": "padding:10px 12px;text-align:left;border-bottom:1.5px solid {primary};color:{ink};font-weight:600;",
    "td": "padding:10px 12px;border-bottom:1px solid {border};color:{body};",
    "td_alt": "padding:10px 12px;border-bottom:1px solid {border};color:{body};background:{surface};",
    "caption": "margin:0 0 32px;text-align:center;font-size:12px;color:{muted};letter-spacing:0.5px;",
    "source": "padding-top:16px;font-size:12px;line-height:1.9;color:{muted};",
    "source_heading": "color:{ink};font-family:{title_font};font-size:18px;font-weight:700;letter-spacing:1px;",
    "source_item": "color:{muted};"
  },
  "code": {
    "bg": "#EEF3F0",
    "text": "#2B2B2B",
    "keyword": "#3D5046",
    "comment": "#62665E",
    "border": "#E8E8E8",
    "accent": "#4A5D52",
    "frame_style": "margin:0 0 26px;overflow:hidden;background:{code_bg};border:1px solid {code_border};border-left:2px solid {code_accent};",
    "header_style": "padding:8px 14px;background:{code_bg};border-bottom:1px solid {code_border};",
    "label_style": "font-size:11px;color:{code_label};font-family:Consolas,Monaco,monospace;letter-spacing:2px;text-transform:uppercase;",
    "body_style": "padding:13px 15px;",
    "line_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.75;color:{code_text};",
    "comment_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.75;color:{code_comment};",
    "keyword_style": "color:{code_keyword};font-weight:700;",
    "label": "#3D5046"
  },
  "html": {
    "head": "<div style=\"margin:44px 0 26px;\"><p style=\"margin:0 0 10px;font-size:10px;color:{primary};font-weight:600;letter-spacing:4px;text-transform:uppercase;\">{{kicker}}</p><h2 style=\"margin:0 0 16px;font-family:{title_font};font-size:22px;font-weight:700;color:{ink};letter-spacing:0.5px;line-height:1.4;\">{{heading}}</h2><span style=\"display:block;width:40px;height:2px;background:{primary};\"></span></div>",
    "takeaways_head": "<div style=\"margin:52px 0 28px;\"><p style=\"margin:0 0 10px;font-size:10px;color:{primary};font-weight:600;letter-spacing:4px;\">SUMMARY</p><h2 style=\"margin:0 0 16px;font-family:{title_font};font-size:22px;font-weight:700;color:{ink};letter-spacing:0.5px;\">{{heading}}</h2><span style=\"display:block;width:40px;height:2px;background:{primary};\"></span></div>",
    "takeaway_item": "<div style=\"display:flex;align-items:baseline;gap:14px;padding:14px 0;border-bottom:1px solid {border};\"><span style=\"flex-shrink:0;font-family:Consolas,Monaco,monospace;font-size:11px;color:{primary};letter-spacing:1px;\">{{n}}</span><p style=\"margin:0;font-size:14px;color:{body};line-height:1.9;flex:1;\">{{text}}</p></div>",
    "closing": "<blockquote style=\"margin:40px 0 32px;padding:30px 16px;border-top:1px solid {border};border-bottom:1px solid {border};text-align:center;font-family:{title_font};font-size:17px;line-height:2;color:{ink};letter-spacing:0.8px;\">{{text}}</blockquote>",
    "source": "<div style=\"margin:36px 0 0;\"><p style=\"margin:0 0 8px;font-size:10px;color:{primary};font-weight:600;letter-spacing:4px;\">NOTES</p><p style=\"margin:0 0 14px;font-family:{title_font};font-size:18px;font-weight:700;color:{ink};letter-spacing:1px;\">{{heading}}</p><div style=\"{{source_style}}\">{{items}}</div></div>",
    "figure": "<div style=\"margin:8px 0 10px;border:1px solid {border};\">{{img}}</div>",
    "figure_caption": "<p style=\"{{caption_style}}\">{{caption}}</p>",
    "table": "<div style=\"margin:0 0 30px;overflow-x:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:13px;\"><tr>{{head}}</tr>{{rows}}</table></div>",
    "code": "<div style=\"{code_frame}\"><div style=\"{code_header}\">{{dots}}<span style=\"{code_label}\">{{lang}}</span></div><div style=\"{code_body}\">{{lines}}</div></div>"
  }
}
