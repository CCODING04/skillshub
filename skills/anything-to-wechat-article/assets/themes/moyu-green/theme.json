{
  "id": "moyu-green",
  "name_zh": "摸鱼绿",
  "style_desc": "轻盈通透的薄荷纸：薄荷色浅底、圆角卡片、荧光笔式强调，读起来像一份清爽的团队手册。",
  "recipe": "清爽、活力、团队手册",
  "tokens": {
    "primary": "#059669",
    "accent": "#FDE68A",
    "ink": "#111827",
    "body": "#374151",
    "muted": "#9CA3AF",
    "muted_dark": "#6B7280",
    "surface": "#F0FDF4",
    "surface_alt": "#F9FAFB",
    "border": "#E5E7EB",
    "border_accent": "#A7F3D0",
    "page_bg": "#FFFFFF",
    "radius": "8px",
    "radius_sm": "6px",
    "font_stack": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif",
    "title_font": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif"
  },
  "page": {
    "max_width": "677px",
    "padding": "24px 20px 56px",
    "font_size": "16px",
    "line_height": "1.75",
    "letter_spacing": "0.5px"
  },
  "styles": {
    "kicker": "margin:0 0 10px;font-size:11px;font-weight:700;letter-spacing:3px;color:{primary};",
    "title": "margin:0 0 12px;font-size:26px;font-weight:900;color:{ink};line-height:1.3;letter-spacing:-0.5px;",
    "subtitle": "margin:0 0 20px;font-size:13px;color:{muted_dark};line-height:1.7;",
    "meta": "margin:0 0 28px;padding:14px 16px;background:{surface};border:1px dashed {border_accent};border-radius:{radius};font-size:13px;line-height:1.9;color:{body};",
    "meta_label": "color:{primary};font-weight:700;",
    "lead": "margin:0 0 16px;font-size:14px;line-height:1.9;text-align:justify;",
    "divider": "margin:8px 0 28px;color:{border_accent};font-size:13px;letter-spacing:6px;text-align:center;",
    "paragraph": "margin:0 0 16px;font-size:14px;line-height:1.9;text-align:justify;",
    "h3": "margin:24px 0 10px;font-size:15px;font-weight:800;color:{ink};",
    "list_item": "margin:0 0 12px;padding-left:30px;text-indent:-30px;font-size:14px;line-height:1.9;",
    "highlight": "border-bottom:2px solid {border_accent};font-weight:600;",
    "quote": "margin:24px 0 28px;padding:16px 18px;background:#FFFFFF;border:1px dashed {border_accent};border-left:4px solid {primary};border-radius:{radius};font-size:15px;line-height:1.9;color:{ink};",
    "card": "margin:0 0 12px;padding:12px 16px;background:{surface_alt};border:1px dashed {border_accent};border-radius:{radius};font-size:14px;line-height:1.8;color:{body};",
    "tip": "margin:0 0 20px;padding:14px 16px;background:#FFFFFF;border:1px dashed {border_accent};border-radius:{radius};font-size:14px;line-height:1.8;color:{body};",
    "th": "background:{primary};color:#FFFFFF;font-weight:700;padding:8px 12px;text-align:left;",
    "td": "padding:8px 12px;border-bottom:1px solid {border};color:{body};",
    "td_alt": "padding:8px 12px;border-bottom:1px solid {border};color:{body};background:{surface_alt};",
    "caption": "margin:0 0 24px;text-align:center;font-size:12px;color:{muted};",
    "source": "background:{surface_alt};border:1px dashed {border};border-radius:{radius};padding:14px 16px;margin:16px 0 0;font-size:12px;line-height:1.8;color:{muted_dark};",
    "source_heading": "color:{ink};font-size:15px;",
    "source_item": "color:{muted_dark};"
  },
  "code": {
    "bg": "#D1FAE5",
    "text": "#04110C",
    "keyword": "#047857",
    "comment": "#4F6B60",
    "border": "#6EE7B7",
    "accent": "#059669",
    "frame_style": "margin:0 0 20px;border-radius:18px;overflow:hidden;background:{code_bg};border:1px solid {code_border};border-left:4px solid {code_accent};",
    "header_style": "display:flex;align-items:center;padding:9px 14px;background:{code_bg};border-bottom:1px solid {code_border};",
    "label_style": "margin-left:12px;font-size:12px;color:{code_label};font-family:Consolas,Monaco,monospace;letter-spacing:1px;",
    "body_style": "padding:11px 14px;",
    "line_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.6;color:{code_text};",
    "comment_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.6;color:{code_comment};",
    "keyword_style": "color:{code_keyword};font-weight:700;",
    "dots": true,
    "label": "#047857"
  },
  "html": {
    "head": "<div style=\"margin:34px 0 22px;\"><div style=\"display:flex;align-items:center;gap:16px;\"><div style=\"text-align:center;flex-shrink:0;\"><p style=\"margin:0;font-size:28px;font-weight:900;color:{primary};line-height:1;letter-spacing:-2px;\">{{no}}</p><p style=\"margin:0;font-size:8px;font-weight:700;color:{border_accent};letter-spacing:2px;\">PART</p></div><span style=\"width:1px;height:36px;background:{border};display:block;\"></span><div><p style=\"margin:0 0 2px;font-size:17px;font-weight:900;color:{ink};letter-spacing:0.3px;\">{{heading}}</p>{{sub_html}}</div></div></div>",
    "takeaways_head": "<div style=\"margin:44px 0 24px;\"><p style=\"margin:0;font-size:28px;font-weight:900;color:{primary};line-height:1;letter-spacing:-2px;\">///</p><p style=\"margin:0 0 2px;font-size:17px;font-weight:900;color:{ink};letter-spacing:0.3px;\">{{heading}}</p><p style=\"margin:0;font-size:11px;font-weight:600;color:{muted};letter-spacing:1.5px;\">SUMMARY</p></div>",
    "takeaway_item": "<div style=\"display:flex;align-items:flex-start;gap:10px;margin:0 0 12px;\"><span style=\"display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;background:{primary};color:#fff;font-size:11px;font-weight:700;border-radius:50%;flex-shrink:0;margin-top:2px;\">{{n}}</span><p style=\"font-size:14px;color:{body};margin:0;line-height:1.9;flex:1;\">{{text}}</p></div>",
    "closing": "<blockquote style=\"margin:24px 0 28px;padding:16px 18px;background:#FFFFFF;border:1px dashed {border_accent};border-radius:{radius};text-align:center;font-size:15px;line-height:1.7;color:{primary};font-weight:700;\">{{text}}</blockquote>",
    "source": "<div style=\"margin:28px 0 0;\"><p style=\"margin:0 0 12px;font-size:15px;font-weight:900;color:{ink};\"><span style=\"background:{accent};padding:0 4px;\">{{heading}}</span></p><div style=\"{{source_style}}\">{{items}}</div></div>",
    "figure": "<div style=\"margin:8px 0 8px;background:#FFFFFF;border-radius:{radius_sm};padding:6px;border:1px solid {border};box-shadow:0 4px 12px -2px rgba(0,0,0,0.08);\">{{img}}</div><p style=\"{{caption_style}}\">{{caption}}</p>",
    "table": "<div style=\"margin:0 0 24px;overflow-x:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:13px;\"><tr>{{head}}</tr>{{rows}}</table></div>",
    "code": "<div style=\"{code_frame}\"><div style=\"{code_header}\">{{dots}}<span style=\"{code_label}\">{{lang}}</span></div><div style=\"{code_body}\">{{lines}}</div></div>"
  }
}
