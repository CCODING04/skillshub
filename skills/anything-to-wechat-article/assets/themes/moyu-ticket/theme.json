{
  "id": "moyu-ticket",
  "name_zh": "摸鱼票据风",
  "style_desc": "黑框纸票据：直角黑边、撕边虚线、错位硬阴影，像一张可以撕下来贴在工位上的操作票。",
  "recipe": "纸质、票据、复古印刷",
  "tokens": {
    "primary": "#059669",
    "accent": "#A7F3D0",
    "ink": "#1A1A1A",
    "body": "#555555",
    "muted": "#888888",
    "muted_dark": "#666666",
    "surface": "#FFFEF8",
    "surface_alt": "#F0FDF4",
    "border": "#1A1A1A",
    "border_accent": "#A7F3D0",
    "page_bg": "#FFFFFF",
    "radius": "0",
    "radius_sm": "0",
    "font_stack": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif",
    "title_font": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif"
  },
  "page": {
    "max_width": "677px",
    "padding": "26px 20px 56px",
    "font_size": "16px",
    "line_height": "1.75",
    "letter_spacing": "0.5px"
  },
  "styles": {
    "kicker": "margin:0 0 10px;font-size:11px;font-weight:700;letter-spacing:2px;color:{primary};",
    "title": "margin:0 0 12px;font-size:26px;font-weight:900;color:{ink};line-height:1.25;letter-spacing:0.5px;",
    "subtitle": "margin:0 0 20px;font-size:13px;color:{muted};line-height:1.7;",
    "meta": "margin:0 0 28px;padding:12px 16px;background:{surface};border:1px solid {ink};box-shadow:4px 4px 0 {ink};font-size:13px;line-height:1.9;color:{body};",
    "meta_label": "color:{ink};font-weight:800;",
    "lead": "margin:0 0 16px;font-size:14px;line-height:1.9;text-align:justify;color:{body};",
    "divider": "margin:6px 0 26px;border-top:1px dashed {ink};height:0;line-height:0;",
    "paragraph": "margin:0 0 16px;font-size:14px;line-height:1.9;text-align:justify;color:{body};",
    "h3": "margin:24px 0 10px;font-size:15px;font-weight:800;color:{ink};border-left:3px solid {primary};padding-left:10px;",
    "list_item": "margin:0 0 8px;padding-left:20px;text-indent:-20px;font-size:14px;line-height:1.9;color:{body};",
    "highlight": "background:{accent};padding:0 3px;font-weight:700;color:{ink};",
    "quote": "margin:24px 0 28px;padding:16px 18px;background:{surface};border:2px solid {ink};box-shadow:4px 4px 0 {ink};font-size:15px;line-height:1.8;color:{ink};font-weight:700;",
    "card": "margin:0 0 12px;padding:12px 16px;background:{surface};border:1px solid {ink};font-size:14px;line-height:1.8;color:{body};",
    "tip": "margin:0 0 20px;padding:13px 16px;background:{surface_alt};border:1px solid {ink};border-left:4px solid {primary};font-size:14px;line-height:1.8;color:{body};",
    "th": "background:{ink};color:{surface};font-weight:700;padding:9px 12px;text-align:left;border:1px solid {ink};",
    "td": "padding:9px 12px;border:1px solid {ink};color:{body};",
    "td_alt": "padding:9px 12px;border:1px solid {ink};color:{body};background:{surface_alt};",
    "caption": "margin:0 0 24px;text-align:center;font-size:12px;color:{muted};letter-spacing:0.5px;",
    "source": "background:{surface};border:1px solid {ink};padding:14px 16px;margin:16px 0 0;font-size:12px;line-height:1.9;color:{muted_dark};",
    "source_heading": "color:{ink};font-size:15px;font-weight:800;",
    "source_item": "color:{muted_dark};"
  },
  "code": {
    "bg": "#F0FDF4",
    "text": "#1A1A1A",
    "keyword": "#047857",
    "comment": "#666666",
    "border": "#1A1A1A",
    "accent": "#059669",
    "frame_style": "margin:0 0 22px;overflow:hidden;background:{code_bg};border:1px solid {code_border};box-shadow:5px 5px 0 {code_border};border-left:4px solid {code_accent};",
    "header_style": "display:flex;align-items:center;padding:9px 14px;background:{code_bg};border-bottom:1px dashed {border_accent};",
    "label_style": "margin-left:12px;font-size:12px;color:{code_label};font-family:Consolas,Monaco,monospace;letter-spacing:1px;",
    "body_style": "padding:11px 14px;",
    "line_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.7;color:{code_text};",
    "comment_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.7;color:{code_comment};",
    "keyword_style": "color:{code_keyword};font-weight:700;",
    "dots": true,
    "label": "#047857"
  },
  "html": {
    "head": "<div style=\"margin:32px 0 20px;padding-bottom:12px;border-bottom:2px solid {ink};display:flex;align-items:center;gap:12px;\"><span style=\"background:{primary};color:#FFFFFF;font-size:12px;font-weight:800;padding:6px 12px;letter-spacing:2px;\">{{no}}</span><span style=\"font-size:18px;font-weight:800;color:{ink};letter-spacing:1px;\">{{heading}}</span>{{sub_inline}}</div>",
    "takeaways_head": "<div style=\"margin:42px 0 22px;padding-top:16px;border-top:3px solid {ink};\"><span style=\"display:inline-block;background:{primary};color:#FFFFFF;font-size:12px;font-weight:800;padding:5px 10px;letter-spacing:2px;\">LAST</span><span style=\"margin-left:10px;font-size:18px;font-weight:800;color:{ink};letter-spacing:1px;\">{{heading}}</span></div>",
    "takeaway_item": "<div style=\"display:flex;align-items:flex-start;gap:12px;padding:12px 0;border-bottom:1px solid {border_accent};\"><span style=\"display:inline-block;flex-shrink:0;margin-top:2px;background:{primary};color:#FFFFFF;font-size:12px;font-weight:700;padding:4px 8px;letter-spacing:1px;\">{{n}}</span><p style=\"margin:0;font-size:14px;color:{body};line-height:1.8;flex:1;\">{{text}}</p></div>",
    "closing": "<blockquote style=\"margin:26px 0 30px;padding:18px;background:{surface};border:2px solid {ink};box-shadow:5px 5px 0 {ink};text-align:center;font-size:16px;line-height:1.8;color:{ink};font-weight:700;\">{{text}}</blockquote>",
    "source": "<div style=\"margin:28px 0 0;\"><div style=\"display:flex;align-items:center;gap:8px;margin-bottom:10px;\"><span style=\"width:4px;height:14px;background:{primary};display:inline-block;\"></span><strong style=\"font-size:14px;color:{ink};letter-spacing:1px;\">{{heading}}</strong></div><div style=\"{{source_style}}\">{{items}}</div></div>",
    "figure": "<div style=\"margin:8px 0 8px;background:{surface};border:1px solid {ink};padding:6px;\">{{img}}</div><p style=\"{{caption_style}}\">{{caption}}</p>",
    "table": "<div style=\"margin:0 0 24px;overflow-x:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:13px;\"><tr>{{head}}</tr>{{rows}}</table></div>",
    "code": "<div style=\"{code_frame}\"><div style=\"{code_header}\">{{dots}}<span style=\"{code_label}\">{{lang}}</span></div><div style=\"{code_body}\">{{lines}}</div></div>"
  }
}
