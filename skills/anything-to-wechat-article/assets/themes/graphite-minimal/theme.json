{
  "id": "graphite-minimal",
  "name_zh": "石墨极简风",
  "style_desc": "无彩灰阶层级：黑白灰三档、超大幽灵序号、左侧细线，只用极少量橙色做锚点。",
  "recipe": "冷峻、极简、技术文档",
  "tokens": {
    "primary": "#52525B",
    "accent": "#F97316",
    "ink": "#27272A",
    "body": "#52525B",
    "muted": "#A1A1AA",
    "muted_dark": "#71717A",
    "surface": "#F4F4F5",
    "surface_alt": "#FAFAFA",
    "border": "#E4E4E7",
    "border_accent": "#27272A",
    "page_bg": "#FFFFFF",
    "radius": "0",
    "radius_sm": "0",
    "font_stack": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif",
    "title_font": "-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei',sans-serif"
  },
  "page": {
    "max_width": "677px",
    "padding": "34px 22px 60px",
    "font_size": "16px",
    "line_height": "1.8",
    "letter_spacing": "0.3px"
  },
  "styles": {
    "kicker": "margin:0 0 14px;font-size:10px;font-weight:500;letter-spacing:3px;color:{muted_dark};text-transform:uppercase;",
    "title": "margin:0 0 14px;font-size:26px;font-weight:800;color:{ink};line-height:1.35;letter-spacing:0.5px;",
    "subtitle": "margin:0 0 22px;font-size:13px;color:{muted_dark};line-height:1.8;",
    "meta": "margin:0 0 30px;padding:14px 16px;background:{surface_alt};border-left:3px solid {accent};font-size:13px;line-height:1.9;color:{muted_dark};",
    "meta_label": "color:{ink};font-weight:700;",
    "lead": "margin:0 0 22px;font-size:15px;line-height:1.8;text-align:justify;color:{body};letter-spacing:0.3px;",
    "divider": "margin:6px 0 30px;border-top:1px solid {border};height:0;line-height:0;",
    "paragraph": "margin:0 0 22px;font-size:15px;line-height:1.8;text-align:justify;color:{body};letter-spacing:0.3px;",
    "h3": "margin:26px 0 12px;font-size:15px;font-weight:700;color:{ink};",
    "list_item": "margin:0 0 9px;padding-left:20px;text-indent:-20px;font-size:14px;line-height:1.8;color:{body};",
    "highlight": "border-bottom:2px solid {primary};font-weight:600;color:{ink};",
    "quote": "margin:28px 0;border-left:3px solid {primary};padding:8px 0 8px 24px;font-size:16px;font-weight:700;color:{ink};line-height:1.8;",
    "card": "margin:0 0 12px;padding:14px 16px;background:{surface_alt};border-top:1px solid {border};font-size:14px;line-height:1.8;color:{body};",
    "tip": "margin:0 0 26px;padding:12px 0 12px 14px;border-left:3px solid {primary};background:{surface_alt};font-size:14px;line-height:1.8;color:{body};",
    "th": "background:{ink};color:#FFFFFF;font-weight:700;padding:8px 12px;text-align:left;",
    "td": "padding:8px 12px;border-bottom:1px solid {border};color:{body};",
    "td_alt": "padding:8px 12px;border-bottom:1px solid {border};color:{body};background:{surface_alt};",
    "caption": "margin:0 0 28px;text-align:center;font-size:12px;color:{muted};letter-spacing:0.5px;",
    "source": "background:{surface_alt};padding:14px 16px;font-size:12px;line-height:1.9;color:{muted_dark};",
    "source_heading": "color:{ink};font-size:16px;font-weight:800;letter-spacing:0.5px;",
    "source_item": "color:{muted_dark};"
  },
  "code": {
    "bg": "#F4F4F5",
    "text": "#27272A",
    "keyword": "#3F3F46",
    "comment": "#6B6B75",
    "border": "#E4E4E7",
    "accent": "#3F3F46",
    "frame_style": "margin:0 0 24px;overflow:hidden;background:{code_bg};border:1px solid {code_border};border-left:3px solid {code_accent};",
    "header_style": "padding:8px 14px;background:{code_bg};border-bottom:1px solid {code_border};",
    "label_style": "font-size:11px;color:{code_label};font-family:Consolas,Monaco,monospace;letter-spacing:1.5px;text-transform:uppercase;",
    "body_style": "padding:12px 14px;",
    "line_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.7;color:{code_text};",
    "comment_style": "margin:0;font-family:'SF Mono',Consolas,Monaco,monospace;font-size:13px;white-space:pre-wrap;word-break:break-all;line-height:1.7;color:{code_comment};",
    "keyword_style": "color:{code_keyword};font-weight:700;",
    "label": "#3F3F46"
  },
  "html": {
    "head": "<div style=\"margin:48px 0 24px;padding-bottom:20px;border-bottom:1px solid {border};\"><p style=\"margin:0;font-size:48px;font-weight:900;color:{border};line-height:1;letter-spacing:-2px;\">{{no}}</p><p style=\"margin:-6px 0 10px;font-size:10px;color:{muted};font-weight:500;letter-spacing:3px;text-transform:uppercase;\">{{kicker}}</p><h2 style=\"margin:0;font-size:20px;font-weight:800;color:{ink};letter-spacing:0.5px;line-height:1.4;\">{{heading}}</h2></div>",
    "takeaways_head": "<div style=\"margin:56px 0 24px;padding-bottom:20px;border-bottom:1px solid {border};\"><p style=\"margin:0;font-size:48px;font-weight:900;color:{border};line-height:1;letter-spacing:-2px;\">END</p><p style=\"margin:-6px 0 10px;font-size:10px;color:{muted};font-weight:500;letter-spacing:3px;\">SUMMARY</p><h2 style=\"margin:0;font-size:20px;font-weight:800;color:{ink};letter-spacing:0.5px;\">{{heading}}</h2></div>",
    "takeaway_item": "<div style=\"display:flex;align-items:flex-start;gap:12px;padding:14px 0;border-bottom:1px solid {border};\"><span style=\"display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;background:{surface};color:{ink};font-size:11px;font-weight:700;flex-shrink:0;margin-top:2px;\">{{n}}</span><p style=\"margin:0;font-size:14px;color:{body};line-height:1.8;flex:1;\">{{text}}</p></div>",
    "closing": "<blockquote style=\"margin:30px 0 32px;padding:10px 0 10px 24px;border-left:3px solid {primary};font-size:16px;font-weight:700;color:{ink};line-height:1.9;\">{{text}}</blockquote>",
    "source": "<div style=\"margin:36px 0 0;\"><p style=\"margin:0 0 10px;font-size:10px;color:{muted};font-weight:500;letter-spacing:3px;\">NOTES</p><p style=\"margin:0 0 12px;font-size:16px;font-weight:800;color:{ink};letter-spacing:0.5px;\">{{heading}}</p><div style=\"{{source_style}}\">{{items}}</div></div>",
    "figure": "<div style=\"margin:8px 0 8px;border:1px solid {border};padding:4px;\">{{img}}</div><p style=\"{{caption_style}}\">{{caption}}</p>",
    "table": "<div style=\"margin:0 0 26px;overflow-x:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:13px;\"><tr>{{head}}</tr>{{rows}}</table></div>",
    "code": "<div style=\"{code_frame}\"><div style=\"{code_header}\">{{dots}}<span style=\"{code_label}\">{{lang}}</span></div><div style=\"{code_body}\">{{lines}}</div></div>"
  }
}
